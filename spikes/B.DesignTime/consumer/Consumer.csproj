<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Spike B's consumer. run.sh copies this folder to a directory OUTSIDE the repository, where
        no Directory.Build.props of the repository applies, and writes a Directory.Build.props of its
        own with SpikeProvider (SQLITE, NPGSQL, SQLSERVER) and SpikeVariant (CTOR, FACTORY, HOST,
        optionally with DTS). It is never built in place.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Consumer</RootNamespace>
        <DefineConstants>$(DefineConstants);$(SpikeProvider);$(SpikeVariant)</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SchemaKit.Spike" Version="0.0.1-spike" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.3.26522.148" PrivateAssets="all" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.3.26522.148" Condition="'$(SpikeProvider)' == 'SQLITE'" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" Condition="'$(SpikeProvider)' == 'NPGSQL'" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-rc.3.26522.148" Condition="'$(SpikeProvider)' == 'SQLSERVER'" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" Condition="$(SpikeVariant.Contains('HOST'))" />
    </ItemGroup>

</Project>
