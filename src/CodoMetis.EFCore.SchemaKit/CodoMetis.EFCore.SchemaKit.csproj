<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>CodoMetis.EFCore.SchemaKit</RootNamespace>
        <PackageId>CodoMetis.EFCore.SchemaKit</PackageId>
        <Description>Schema objects EF Core 11 has no API for, declared in the model and carried by migrations. The kernel: the host that puts them into every migration path, and the contract other packages contribute through.</Description>
        <!-- CS1591 polices the public surface: the .xml in the package is what a consumer sees. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- SK9001 marks SchemaKit's contributor contract as experimental for everyone else. The kernel
             is that contract's owner and first user, so it does not ask itself for the opt-in. -->
        <NoWarn>$(NoWarn);SK9001</NoWarn>
    </PropertyGroup>

    <!--
        EF1001 (use of EF-internal API) is an error here like every warning, and nothing in this
        project disables it: the host wraps IMigrationsModelDiffer and IMigrationsSqlGenerator
        instead of deriving from EF's classes, so an EF patch cannot break it through a base class.
        InternalApiConventionTests holds that no file and no property here switches it off.
    -->

    <ItemGroup>
        <!-- Npgsql EF 11.0.0-rc.3 pins EF Core to exactly this build; the floor moves to 11.0.0 when
             Npgsql ships its own. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0-rc.3.26522.148" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="CodoMetis.EFCore.SchemaKit.Tests" />
    </ItemGroup>

</Project>
