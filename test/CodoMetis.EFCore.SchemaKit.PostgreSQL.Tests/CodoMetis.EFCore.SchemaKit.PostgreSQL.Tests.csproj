<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <RootNamespace>CodoMetis.EFCore.SchemaKit.PostgreSQL.Tests</RootNamespace>
        <!-- The snapshot harness drives EF's design-time services, which are EF-internal. The shipping
             project never disables EF1001; InternalApiConventionTests holds it to that.
             SK9001 is the kernel's experimental contract, which the read model is still part of. -->
        <NoWarn>$(NoWarn);EF1001;SK9001;1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/CodoMetis.EFCore.SchemaKit.PostgreSQL/CodoMetis.EFCore.SchemaKit.PostgreSQL.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="MSTest" Version="4.5.2" />
    </ItemGroup>

    <!-- One copy of each: what scaffolds and compiles a model snapshot, and what finds the server. -->
    <ItemGroup>
        <Compile Include="../CodoMetis.EFCore.SchemaKit.Tests/Harness/Snapshots.cs" Link="Harness/Snapshots.cs" />
        <Compile Include="../CodoMetis.EFCore.SchemaKit.Tests/Integration/PostgresServer.cs" Link="Integration/PostgresServer.cs" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>

</Project>
