<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <RootNamespace>CodoMetis.EFCore.SchemaKit.Tests</RootNamespace>
        <!-- Tests play a stranger's package and drive EF's design-time services, both EF-internal.
             The shipping project never disables this; InternalApiConventionTests holds it to that.
             SK9001 is SchemaKit's own experimental contract, which these tests are about. -->
        <NoWarn>$(NoWarn);EF1001;SK9001;1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/CodoMetis.EFCore.SchemaKit/CodoMetis.EFCore.SchemaKit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Npgsql EF rc.3 pins EF Core to [11.0.0-rc.3.26522.148]; everything follows it. -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-rc.3.26522.148" />
        <!-- Not used by this project: Microsoft.EntityFrameworkCore.SqlServer brings Microsoft.Data.SqlClient
             7.1.0, which asks for System.Security.Cryptography.Pkcs 9.0.18, and that version has two
             advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7; fixed in 9.0.21). SqlClient 7.1.1 still
             asks for 9.0.18. Remove this line when the provider's own dependency is patched (issue 67). -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.23" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="MSTest" Version="4.5.2" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>

</Project>
