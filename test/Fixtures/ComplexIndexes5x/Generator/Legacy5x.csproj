<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Not part of the solution and never built by it: this is a consumer of the PUBLISHED 5.x
        packages on net10.0, and generate.sh builds it outside the repository. What it scaffolds
        is checked in under ../Scaffolded.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Legacy5x</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="EFCore.ComplexIndexes.PostgreSQL" Version="5.6.0" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" PrivateAssets="all" />
    </ItemGroup>

</Project>
