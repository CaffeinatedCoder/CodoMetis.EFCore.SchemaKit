<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Compile probes for design/schemakit-api.md.

        Prototype/ is the proposed SchemaKit surface as compilable declarations, and Probes/ compiles
        each forbidden declaration against it with Roslyn and asserts the diagnostic. CI runs it in
        the `API probes` job of dotnet.yml.

        The prototype is not the implementation. It carries just enough behaviour for the probes
        and for a handful of sanity tests (annotation keys, DDL shape), and it has defects the core
        plan lists on purpose (design/schemakit-core-plan.md, sections 3.4, 3.8 and 3.9). It is
        deleted once 11.0.0-preview.1 ships the real kernel, whose own tests take the probes over.
    -->

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <RootNamespace>SchemaKit.ApiProbes</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- The floor of the packages, as in the solution. -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
        <!-- The compiler the probes drive in-process: the one the rc.2 SDK ships, from the
             dotnet-tools feed (see nuget.config for why not nuget.org's 5.9.0). -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0-1.26504.105" />
        <PackageReference Include="MSTest" Version="4.5.2" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The kernel, for the probes that hold "does not compile" against the shipping types
            (Probes/KernelProbeTests.cs). Behind an alias: the prototype declares types of the same
            names in the same namespace, and without the alias this project's own compile would see
            both. The probes compile their snippets against the kernel's assembly alone.
        -->
        <ProjectReference Include="../../src/CodoMetis.EFCore.SchemaKit/CodoMetis.EFCore.SchemaKit.csproj" Aliases="kernel" />
    </ItemGroup>

    <!--
        The .NET analyzers the SDK runs on every project, copied beside the tests: the kernel probes
        compile a snippet as a contributor's build does, and a rule of the contract can be one of
        theirs (CA1857 on SqlHandler.AppendLiteral, #109). The SDK adds them as Analyzer items in a
        file imported after this one, so they are read in a target, not at evaluation.
    -->
    <Target Name="CopyNetAnalyzersForProbes" AfterTargets="Build">
        <ItemGroup>
            <_ProbeAnalyzer Include="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.CodeAnalysis.NetAnalyzers' Or '%(Filename)' == 'Microsoft.CodeAnalysis.CSharp.NetAnalyzers'" />
        </ItemGroup>
        <Error Condition="'@(_ProbeAnalyzer->Count())' != '2'" Text="The SDK's .NET analyzers were not found among the Analyzer items: the kernel probes need them." />
        <Copy SourceFiles="@(_ProbeAnalyzer)" DestinationFolder="$(OutDir)netanalyzers" SkipUnchangedFiles="true" />
    </Target>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>

</Project>
