<Project Sdk="Microsoft.NET.Sdk">

    <!--
        A project that comes from EFCore.ComplexIndexes 5.x: run.sh copies the snapshot and the
        migration the published 5.6.0 scaffolded (test/Fixtures/ComplexIndexes5x/Scaffolded) into
        Migrations/ as they are, and this project declares the same constraints with SchemaKit.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Legacy5x</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Shared/Wiring.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CodoMetis.EFCore.SchemaKit.PostgreSQL" Version="$(SchemaKitVersion)" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlEfVersion)" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfVersion)" PrivateAssets="all" />
    </ItemGroup>

</Project>
